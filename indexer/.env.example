# Local Anvil dev
#
# DATABASE_URL: leave UNSET for local dev. Ponder auto-selects its in-process
# pglite store (indexer/.ponder/pglite) when DATABASE_URL is absent — that's the
# `just indexer-dev` path and needs no external server. Setting DATABASE_URL
# switches Ponder to Postgres via pg-pool; if nothing is listening on that
# address you get an endless "Connection terminated unexpectedly" retry loop.
# Only uncomment (and point at a running Postgres) for a Postgres-backed run.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/commitments_indexer
ANVIL_RPC_URL=http://localhost:8545
ANVIL_WS_URL=ws://localhost:8545

# Set to "PROD" to enable Ethereum mainnet (requires PONDER_RPC_URL_1).
DEPLOY_ENV=LOCAL
PONDER_RPC_URL_1=
PONDER_WS_URL_1=

# IPFS gateway used by the metadata fetcher to resolve ipfs:// URIs on read.
# Default: https://ipfs.io/ipfs/
# Plain http:// is fine here even though the fetcher's allowlist rejects http://
# *URIs*: an ipfs:// URI is rewritten through this gateway and the rewritten URL
# is fetched directly, with no second scheme check.
#   Local Kubo (see docker-compose.yml): http://127.0.0.1:8080/ipfs/
IPFS_GATEWAY=

# ── Pinning backends for POST /metadata/pin, in precedence order ────────────
# Each step down trades durability for not needing an account. With none of
# them set the endpoint inlines the document as a data: URI, which works
# offline but has to fit inside the contract's 512-byte URI cap (~360 bytes of
# JSON) — enough for a title and a couple of sentences, not for real prose.

# 1. Server-side Pinata JWT. Scoped token with pinFileToIPFS permission.
#    NEVER expose this to the browser.
PINATA_JWT=

# 2. A local or self-hosted Kubo node's HTTP API. `just ipfs-up` starts one.
#    Set only when a node is actually running: a configured-but-unreachable
#    node makes /metadata/pin return 502 rather than silently downgrading to
#    the data: fallback and reintroducing the size cap.
#   Local Kubo: http://127.0.0.1:5001
IPFS_API_URL=
