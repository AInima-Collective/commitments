VITE_WALLETCONNECT_PROJECT_ID=
VITE_RPC_URL_MAINNET=
VITE_RPC_URL_SEPOLIA=
VITE_RPC_URL_ANVIL=http://127.0.0.1:8545
VITE_EXPECTED_CHAIN_ID=31337
VITE_COMMITMENTS_VAULT_ADDRESS=
VITE_COMMITMENT_MANAGER_ADDRESS=
VITE_OPERATOR_REGISTRY_ADDRESS=
VITE_STAKE_REGISTRY_ADDRESS=
VITE_DEFAULT_ARBITER_ADDRESS=
VITE_MANUAL_ARBITER_ADDRESS=
VITE_OPTIMISTIC_INSURANCE_ARBITER_ADDRESS=
VITE_OPTIMISTIC_MUTUAL_ARBITER_ADDRESS=
VITE_ATTESTATION_ARBITER_ADDRESS=
VITE_TWO_TIER_ARBITER_ADDRESS=
VITE_INDEX_YIELD_STRATEGY_ADDRESS=
VITE_FLAT_FEE_STRATEGY_ADDRESS=

# Indexer (Ponder). Vault lists, memberships, agreements, activity and the graphs
# read it; left blank, only direct-RPC reads work.
VITE_INDEXER_URL=http://localhost:65422

# Gateway the browser resolves ipfs:// metadata links through (terms documents,
# operator logos, "open URI" affordances). Default: https://ipfs.io/ipfs/
# Point it at a local Kubo node when running one — `just ipfs-up` prints the
# value, and `just dev-up` copies IPFS_GATEWAY into .env.local as this var.
VITE_IPFS_GATEWAY=

# ───────────────────────────────────────────────────────────────────────────
# Sepolia (chainId 11155111) deployment
# ───────────────────────────────────────────────────────────────────────────
# To point the dapp at the Sepolia deployment, set:
#   VITE_EXPECTED_CHAIN_ID=11155111
#   VITE_RPC_URL_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/<KEY>   (or Infura/public)
#   VITE_INDEXER_URL=https://<your-hosted-ponder>                      (deployed indexer)
# The contract addresses below are auto-written by
#   CHAIN_ID=11155111 INDEXER_URL=<url> node script/write-frontend-env.mjs
# (reads broadcast/DeploySepolia.s.sol/11155111/run-latest.json; DEFAULT_ARBITER_ADDRESS
# overrides the default arbiter). On a host without that broadcast, set the
# VITE_* addresses by hand.
